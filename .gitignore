# ---------- Data: keep the folder skeleton, ignore the contents ----------
data/raw/**
data/interim/**
data/processed/**
data/quarantine/**
!data/raw/**/
!data/interim/**/
!data/processed/**/
!data/quarantine/**/
!data/**/.gitkeep

# Parquet anywhere, except the small committed sample
*.parquet
!data/sample/*.parquet

# ---------- Secrets ----------
.env
kaggle.json

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Editors / OS ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---------- Office lock files (created while Excel/Word has a file open) ----------
~$*